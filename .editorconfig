
root = true

[*]
indent_size = 4
indent_style = space
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = tab
dotnet_sort_system_directives_first = false
dotnet_style_qualification_for_field = true

[*.Designer.cs]
dotnet_style_qualification_for_field = true
dotnet_style_qualification_for_property = true
dotnet_style_qualification_for_method = true
dotnet_style_qualification_for_event = true

[*.csproj]
indent_size = 2
insert_final_newline = false

[*.publish.xml]
indent_size = 2

[*.md]
indent_style = tab
end_of_line = lf
trim_trailing_whitespace = false

# the web app and its tooling: LF, tabs (docs/spec/12-architecture.md)
[{app/**,tests/**,eslint.config.js,playwright.config.js,jsconfig*.json}]
indent_style = tab
end_of_line = lf

[{package.json,package-lock.json,*.yml,*.yaml,.claude/**}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.sh]
end_of_line = lf
